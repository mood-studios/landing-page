# ─── Local dev (recommended) ───────────────────────────────────────────────
# Leave VITE_API_URL empty. Vite proxies /api → http://localhost:5000 so
# login cookies are same-origin (localhost:5173). Backend needs:
#   LANDING_URL=http://localhost:5173

# VITE_API_URL=

# ─── Production (landing and API on different hosts) ───────────────────────
# Point at your API origin (no trailing slash). Requests use credentials:
# include, so the API must list your landing origin in LANDING_URL and use
# NODE_ENV=production (httpOnly cookie: Secure + SameSite=None).
#
# VITE_API_URL=https://api.yourdomain.com
# VITE_SOCKET_URL=https://api.yourdomain.com
